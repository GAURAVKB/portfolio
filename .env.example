# ── Spring Boot (portfolio-api) ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/portfolio
DB_USERNAME=portfolio
DB_PASSWORD=portfolio_dev

# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-very-long-random-secret-minimum-256-bits

# Resend: https://resend.com → API Keys → Create API Key
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=noreply@yourdomain.com
ADMIN_EMAIL=you@youremail.com

# CORS — your Vercel URL in prod
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Go service (go-metrics) ───────────────────────────────────────────────────
PORT=9090
GITHUB_USERNAME=GAURAVKB
GITHUB_REPO=portfolio
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
ALLOWED_ORIGIN=http://localhost:4200

# ── GitHub Actions secrets (add in repo Settings → Secrets) ──────────────────
# VERCEL_TOKEN          → Vercel dashboard → Account → Tokens
# VERCEL_ORG_ID         → vercel.json or `vercel whoami`
# VERCEL_PROJECT_ID     → .vercel/project.json after first `vercel` run
# RENDER_JAVA_DEPLOY_HOOK → Render dashboard → Service → Settings → Deploy Hook
# RENDER_GO_DEPLOY_HOOK   → same for Go service
